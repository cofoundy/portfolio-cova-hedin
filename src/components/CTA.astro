---
import { siteConfig } from "../config";
---

<section id="contact" class="py-16 md:py-20 relative overflow-hidden" style={`background-color: ${siteConfig.colors.surface}`}>
  <!-- Decorative Swedish cross pattern -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 rounded-full" style={`background: radial-gradient(circle, ${siteConfig.colors.accent}08 0%, transparent 70%);`}></div>
  </div>

  <div class="max-w-5xl mx-auto px-6 lg:px-8 relative reveal">
    <div class="flex flex-col md:flex-row items-center gap-10 md:gap-16">
      <!-- Photo - left side on desktop, hidden on mobile -->
      <div class="hidden md:block flex-shrink-0 relative">
        <div class="relative">
          <!-- Decorative frame -->
          <div class="absolute -inset-3 rounded-2xl border-2" style={`border-color: ${siteConfig.colors.primaryLight}40;`}></div>
          <img
            src={`${import.meta.env.BASE_URL}cova-cta.png`}
            alt={siteConfig.name}
            class="w-64 lg:w-72 h-auto rounded-xl object-cover relative z-10"
          />
          <!-- Reviews badge -->
          <div class="absolute -bottom-3 -right-3 z-20 flex items-center gap-1.5 px-3 py-1.5 rounded-lg shadow-lg" style={`background-color: ${siteConfig.colors.primaryDark}; color: ${siteConfig.colors.accent};`}>
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <span class="text-sm font-bold text-white">5,312 reviews</span>
          </div>
        </div>
      </div>

      <!-- CTA Content -->
      <div class="text-center md:text-left flex-1">
        <p class="font-mono-accent text-xs tracking-[0.25em] uppercase mb-3" style={`color: ${siteConfig.colors.accent}`}>
          Let's start
        </p>
        <h2 class="text-3xl md:text-5xl font-bold leading-tight" style={`color: ${siteConfig.colors.primaryDark}`}>
          Ready to learn<br/>Swedish?
        </h2>
        <p class="mt-4 text-gray-500 text-base md:text-lg max-w-md">
          {siteConfig.cta.description}
        </p>

        <!-- Service types as pills -->
        <div class="mt-8 flex flex-wrap justify-center md:justify-start gap-2">
          {siteConfig.services.map((s: any) => (
            <span
              class="px-4 py-2 rounded-full text-sm font-medium"
              style={`background-color: ${siteConfig.colors.primaryDark}06; color: ${siteConfig.colors.primaryDark};`}
            >
              {s.title}
            </span>
          ))}
        </div>

        <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center md:justify-start">
          <a
            href={siteConfig.bookingUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-hover inline-flex items-center justify-center gap-2 px-8 py-4 rounded-full font-semibold text-base shadow-lg"
            style={`background-color: ${siteConfig.colors.accent}; color: ${siteConfig.colors.primaryDark};`}
          >
            Book a Lesson &#x2192;
          </a>
          <a
            href={`mailto:${siteConfig.social.email}?subject=${encodeURIComponent(siteConfig.cta.emailSubject)}`}
            class="btn-hover inline-flex items-center justify-center gap-2 px-8 py-4 rounded-full font-semibold text-base border-2"
            style={`border-color: ${siteConfig.colors.primaryDark}20; color: ${siteConfig.colors.primaryDark};`}
          >
            Work with Me
          </a>
        </div>

        <p class="mt-6 text-xs text-gray-400 font-mono-accent">
          {siteConfig.social.email}
        </p>
      </div>
    </div>
  </div>
</section>
